# Zernio API Configuration
# Get your API key at: https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=sk_your_zernio_api_key_here
VITE_ZERNIO_API_KEY=sk_your_zernio_api_key_here
ZERNIO_PROFILE_ID=your_profile_id_here

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Server Port
PORT=5176
VITE_API_URL=http://localhost:5176
